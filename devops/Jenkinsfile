/*
  Practica 2 - Pipelines CI/CD en Jenkins con Docker y Groovy
*/

pipeline {
  // `agent any` = el pipeline se ejecuta en cualquier nodo/agente disponible.
  agent any

  stages {

    // ==========================
    // Practica 2 - Ejercicio 1
    // ==========================
    stage('Info') {
      steps {
        // Imprime JOB_NAME y BUILD_NUMBER
        echo "Job: ${env.JOB_NAME}"
        echo "Build: ${env.BUILD_NUMBER}"
      }
    }

    // ==========================
    // Practica 2 - Ejercicio 3
    // ==========================
    stage('Build CI Image') {
      steps {
        script {
          // Construir imagen CI para ejecutar 'make link' y 'make test'
          // Nombre: 'python-imagen-ci'
          docker.build('python-imagen-ci', '-f devops/ci.Dockerfile .')
        }
      }
    }

    stage('Lint') {
      agent {
        docker { 
          image 'python-imagen-ci' 
        }
      }
      steps {
        // Instala dependencias del proyecto + herramientas de revisión de reglas de estilo y tipos de datos
        sh 'pip install -r requirements.txt flake8 mypy'
        sh 'make lint'
        }
      }

    stage('Test') {
      agent {
        docker { 
          image 'python-imagen-ci' 
        }
      }
      steps {
        // Instala dependencias 
        sh 'pip install -r requirements.txt flake8 pytest'
        sh 'pytest -q'
        sh 'make test'
      }
    }

    
  }
}
